          "name": "Create A User-Scoped Worker Token",
          "request": {
            "name": "Create A User-Scoped Worker Token",
            "description": {
              "content": "Create a one-hour user-scoped token for a My Machines worker to run as an\nactive team member. Requires an agent-scoped team service account\nAPI key. User-scoped tokens can't mint other user-scoped tokens.\n",
              "type": "text/plain"
            },
