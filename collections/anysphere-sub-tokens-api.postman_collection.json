  "info": {
    "_postman_id": "454f4f96-11e5-49c8-b606-6804818dc572",
    "name": "Cursor Cloud Agents Sub Tokens API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Programmatically create and manage Cursor Cloud Agents that work\nautonomously on your repositories. v1 separates a durable agent\nfrom one or more runs: each prompt submission creates a run on the\nagent. Streaming and cancellation are scoped to the active run.\n\n\nContact Support:\n Email: background-agent-feedback@cursor.com",
      "type": "text/plain"
    }
  }
