  "info": {
    "_postman_id": "9f3a63b9-573d-4c02-9003-c184280b06dc",
    "name": "Cursor Cloud Agents Sub Tokens API",
    "description": "Programmatically create and manage Cursor Cloud Agents that work\nautonomously on your repositories. v1 separates a durable agent\nfrom one or more runs: each prompt submission creates a run on the\nagent. Streaming and cancellation are scoped to the active run.\n\n\nContact Support:\n Email: background-agent-feedback@cursor.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:01:00.000Z",
    "updatedAt": "2026-07-28T01:01:00.000Z",
